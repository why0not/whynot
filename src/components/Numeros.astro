---
// Generamos los números del 1 al 500 y los formateamos a 3 dígitos ("001", "002", ..., "500")
const numeros = Array.from({ length: 500 }, (_, i) => 
  String(i + 1).padStart(3, '0')
);
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sorteo - Números del 001 al 500</title>
  </head>
  <body>
    <main class="container">
      <h1>Elige tu número</h1>
      
      <div class="grid-loteria">
        {numeros.map((num) => (
          <button class="numero-btn" data-numero={num}>
            {num}
          </button>
        ))}
      </div>
    </main>

    <script>
        // Sustituye con las credenciales de tu proyecto (Settings > API en Supabase)
        const SUPABASE_URL='https://bztzxsfsjrzndsanhmwy.supabase.co';
        const SUPABASE_KEY='sb_publishable_4HlkD3c2z3tv_YoiTH8d3Q_B88VoH-t';
        
        

        async function cargarEstadoNumeros() {
            try {
            // 1. Pedimos ÚNICAMENTE número y estado (Optimización de ancho de banda)
            const response = await fetch(`${SUPABASE_URL}/rest/v1/vista_boletos_publica?select=numero,estado`, {
                headers: {
                'apikey': SUPABASE_KEY,
                'Authorization': `Bearer ${SUPABASE_KEY}`
                }
            });

            if (!response.ok) throw new Error('Error en la petición a Supabase');

            const boletos = await response.json();

            // 2. Recorremos los registros devueltos y marcamos los vendidos
            boletos.forEach((boleto: { numero: string; estado: string }) => {
                if (boleto.estado === 'pagado') {
                // Buscamos el botón por su atributo data-numero
                const btn = document.querySelector(`[data-numero="${boleto.numero}"]`);
                if (btn) {
                    btn.classList.add('vendido');
                    btn.setAttribute('disabled', 'true');
                }
                }
            });
            } catch (error) {
            console.error('Error al conectar con Supabase:', error);
            }
        }

        // Se ejecuta una sola vez al cargar o recargar la página
        cargarEstadoNumeros();
    </script>

    <style>


        /* 1. Reset Global y CSS Normalizer */
        *,
        *::before,
        *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --bg-color: #0f172a;
            --card-bg: #1e293b;
            --accent: #3b82f6;
            --accent-hover: #2563eb;
            --text: #f8fafc;
        }

        body {
            /* padding: 2rem 1rem; */
            background-color: var(--bg-color);
            color: var(--text);
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            min-height: 100vh;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem 1rem;
            text-align: center;
        }

        h1 {
            margin-bottom: 2rem;
            font-size: 2rem;
        }

        /* Cuadrícula tipo Lotería */
        /* Se adapta automáticamente al tamaño de pantalla creando tantas columnas como quepan */
        .grid-loteria {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(70px, 1fr));
            gap: 0.5rem;
            background-color: var(--card-bg);
            padding: 1.5rem;
            border-radius: 12px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
        }

        /* Botón de cada número */
        .numero-btn {
            background-color: #334155;
            color: var(--text);
            border: 1px solid #475569;
            border-radius: 6px;
            padding: 0.75rem 0.25rem;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.15s ease-in-out;
        }

        .numero-btn:hover {
            background-color: var(--accent);
            border-color: var(--accent-hover);
            transform: scale(1.05);
        }

        .numero-btn:active {
            transform: scale(0.95);
        }

        /* Estilo visual para los números no disponibles */
        .numero-btn.vendido {
            background-color: #ef4444 !important; /* Rojo */
            border-color: #dc2626 !important;
            color: #ffffff !important;
            cursor: not-allowed;
            opacity: 0.6;
            transform: none !important;
        }
    </style>
  </body>
</html>