---
import Navbar from "../components/Navbar.astro";

interface Props {
  title?: string;
}

const { title = "Porque No?" } = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
    </head>
    <body>
        <Navbar />
        <main class="page-container">
            <slot />
        </main>
    </body>
</html>

<style is:global>
    html {
        scroll-behavior: smooth;
        scroll-padding-top: 60px;
        font-family: system-ui, sans-serif;

		scroll-behavior: smooth;
    	scroll-padding-top: 70px; /* Offset para que la barra fija no tape los títulos */
    }

    body {
        margin: 0;
        width: 100%;
        /* CAMBIO CLAVE: Usar min-height para que crezca libremente según el contenido */
        min-height: 100vh;
        min-height: 100dvh;

		scroll-behavior: smooth;
    	scroll-padding-top: 70px; /* Offset para que la barra fija no tape los títulos */
    }

    .page-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 20px;
        padding-bottom: 4rem;
        max-width: 600px;
        margin: 0 auto;
    }
</style>
