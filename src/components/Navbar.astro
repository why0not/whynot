---
// src/components/Navbar.astro
---

<header class="navbar-header">
  <nav class="navbar">
    <a href="#hero" class="nav-link">Inicio</a>
    <a href="#numeros" class="nav-link">Números</a>
    <a href="#reglas" class="nav-link">Reglas</a>
  </nav>
</header>

<style>
  /* Header fijo en la parte superior */
  .navbar-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px); /* Efecto cristal limpio */
    border-bottom: 1px solid #e5e7eb;
    width: 100%;
  }

  .navbar {
    display: flex;
    justify-content: center;
    gap: 24px;
    max-width: 500px;
    margin: 0 auto;
    padding: 12px 16px;
  }

  .nav-link {
    text-decoration: none;
    color: #374151;
    font-size: 0.95rem;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .nav-link:hover {
    color: #2563eb;
  }
</style>